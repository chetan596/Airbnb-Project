<%- include('../header/header.ejs') %>

  <body>
    <%- include('../listing/navsmall.ejs') %>

      <main class="wishlist">
        <span class="wishlist_hading">
          <h1>Wishlists</h1>
        </span>
        <div class="wishlist_container">
          <% for (data of rtrr) { %>
            <a href="">
            <div class="wishlist_boxs">
              <% if (data.key.split("_").join(" ") != "Recently viewed") { %>
                 <div class="DeletewishListContanter">
                  <button class="DeletewishList" onclick="deleteWishList('<%= data.key%>')"><i class="ri-close-line"></i></button>
              </div>
              <% } %>
               
              <% if (data.hotelImgs && data.hotelImgs.length> 0) { %>
                <div class="wishList-image-box">
                  <div class="image_box_con">
                    <div class="wishList-hotel-images recent_image1">
                      <% if (data.hotelImgs[0]) { %>
                        <img src="<%= data.hotelImgs[0].path %>" alt="">
                        <% } %>
                    </div>
                    <div class="wishList-hotel-images recent_image2">
                      <% if (data.hotelImgs[1]) { %>
                        <img src="<%= data.hotelImgs[1].path %>" alt="">
                        <% } %>
                    </div>
                  </div>

                  <div class="image_box_con">
                    <div class="wishList-hotel-images recent_image3">
                      <% if (data.hotelImgs[2]) { %>
                        <img src="<%= data.hotelImgs[2].path %>" alt="">
                        <% } %>
                    </div>
                    <div class="wishList-hotel-images recent_image4">
                      <% if (data.hotelImgs[3]) { %>
                        <img src="<%= data.hotelImgs[3].path %>" alt="">
                        <% } %>
                    </div>
                  </div>
                </div>

                <div class="wishlist_distele">





                  <p>
                    <%= data.key.split("_").join(" ") %></p>
                        <%
function formatViewDate(dateString) {
  const date = new Date(dateString);
  const today = new Date();
  const d1 = new Date(date.getFullYear(), date.getMonth(), date.getDate());
  const d2 = new Date(today.getFullYear(), today.getMonth(), today.getDate());

  const diffTime = d1 - d2;
  const diffDays = diffTime / (1000 * 60 * 60 * 24);

  if (diffDays === 0) return " Today"; if (diffDays===1) return "Tomorrow" ; if (diffDays===-1) return "Yesterday" ;
                      const options={ day: "2-digit" , month: "short" }; return date.toLocaleDateString("en-US",
                      options); } %>

                      <p>
                        <%= formatViewDate(data.viewDate) %>
                      </p>

                </div>

                <% } else { %>
                  <div class="wishList-image-box blackWishList">
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="presentation"
                      focusable="false" style="display: block; height: 60px; width: 60px; fill: white;">
                      <path
                        d="m18.1689647 3c7.1797017 0 13 5.82029825 13 13 0 7.1797017-5.8202983 13-13 13-3.1791192 0-6.1832801-1.1465435-8.5324472-3.1917399l1.3132502-1.5084342c1.9884655 1.7311678 4.5274455 2.7001741 7.219197 2.7001741 6.0751322 0 11-4.9248678 11-11 0-6.07513225-4.9248678-11-11-11-5.9917147 0-10.86453655 4.79054974-10.99722414 10.7504078l3.32825944-2.9937019 1.3379294 1.4865882-4.99999994 4.5c-.38030497.3422745-.95762449.3422745-1.33792946 0l-5-4.5 1.33792946-1.4865882 3.33307054 2.9992941.00151517-.0628562c.16302123-7.03795197 5.91931493-12.6931438 12.99644953-12.6931438zm1 4v8.419l6.4961389 3.7127569-.9922778 1.7364862-7.5038611-4.2879206v-9.5803225z">
                      </path>
                    </svg>
                  </div>

                  <div class="wishlist_distele">
                    <p>
                      <%= data.key.split("_").join(" ") %></p>
                        


                    </div>
                                          
                <% } %>
                                        
                                           
                   

                    


               </div>

               
              
               <% } %>

              
              
            </a>

                   
                    
              
               <!-- <div class=" wishlist_boxs">
                        <div class="wishList-image-box">

                        </div>
                  </div>
                  <div class="wishlist_boxs">
                    <div class="wishList-image-box">

                    </div>
                  </div>
                  <div class="wishlist_boxs">
                    <div class="wishList-image-box">

                    </div>
                  </div> -->

            </div>
      </main>
  </body>

  <script src="/wishList.js"></script>