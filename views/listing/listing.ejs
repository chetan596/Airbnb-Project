       <main>
        <div class="listing">
          <% for( listing of listingData ) { %>
            <a href="/<%=listing._id%>">
              <div class="listing-box ">
                <img draggable="false" loading="lazy" src="<%= listing.image %>" alt="">
                <div class="listing-cont">
                  <div class="reting">
                    <p>
                      <%= listing.title %>
                    </p>
                    <div class="star">
                      <i class="ri-star-fill"></i>
                      <p>4.3</p>
                    </div>
                  </div>
                  <p class="kol">
                    <%= listing.country %>
                  </p>
                  <p class="kol">12-13 Mar</p>
                  <div class="price"><span>&#8377;<%=listing.price.toLocaleString("en-IN")%></span>
                    <p>for 5 nights</p>
                  </div> 
                </div>
              </div>
            </a>
            <% } %>


        </div>
        </div>
      </main>
